{
    "name": "laravel/laravel",
    "type": "project",
    "description": "The Laravel Framework.",
    "keywords": ["framework", "laravel"],
    "license": "MIT",

    "require": {
        "php": "7.4.33",

        "laravel/framework": "^8.0",
        "laravel/ui": "^3.0",
        "laravel/scout": "^9.0",
        "laravel/socialite": "5.10",
        "laravel/tinker": "^2.5",
        "laravelcollective/html": "^6.2",

        "aws/aws-sdk-php": "^3.273",
        "league/flysystem-aws-s3-v3": "~1.0",

        "barryvdh/laravel-dompdf": "^2.0",
        "intervention/image": "^2.7",
        "maatwebsite/excel": "^3.1",

        "guzzlehttp/guzzle": "^7.0.1",
        "predis/predis": "^1.1",

        "doctrine/dbal": "^2.13",
        "nyholm/psr7": "^1.4",

        "spatie/laravel-permission": "^5.10",
        "spatie/db-dumper": "^2.21",
        "spatie/geocoder": "^3.10",

        "sentry/sentry-laravel": "^2.7",

        "razorpay/razorpay": "2.*",
        "stripe/stripe-php": "^7.100",
        "braintree/braintree_php": "^6.8",
        "omnipay/paypal": "^3.0",
        "omnipay/stripe": "^3.1",

        "kreait/firebase-php": "^5.26",
        "kreait/laravel-firebase": "^3.1",

        "ladumor/laravel-pwa": "^0.0.4",

        "twilio/sdk": "^6.13",
        "vonage/client": "2.3",

        "yajra/laravel-datatables-oracle": "^9.18",
        "webpatser/laravel-uuid": "^4.0",

        "jenssegers/agent": "^2.6",
        "rap2hpoutre/laravel-log-viewer": "^1.7"
    },

    "require-dev": {
        "barryvdh/laravel-debugbar": "^3.6",
        "facade/ignition": "^2.3.6",
        "fakerphp/faker": "^1.9.1",
        "mockery/mockery": "^1.3.1",
        "nunomaduro/collision": "^5.0",
        "phpunit/phpunit": "^8.5.8"
    },

    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "platform": {
            "php": "7.4.33"
        },
        "allow-plugins": {
            "symfony/thanks": true,
            "php-http/discovery": true
        }
    },

    "autoload": {
        "psr-4": {
            "App\\": "app/"
        },
        "files": [
            "app/helpers.php"
        ],
        "classmap": [
            "database/seeders",
            "database/factories"
        ]
    },

    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },

    "minimum-stability": "dev",
    "prefer-stable": true,

    "scripts": {
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi"
        ]
    }
}
